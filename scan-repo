                "$osv_file" 2>/dev/null >> "$md_file"
        else
            echo "No findings." >> "$md_file"
        fi
        echo "" >> "$md_file"
        echo "---" >> "$md_file"
        echo "" >> "$md_file"
    fi

    # --- Dockerfile / IaC findings ---
    local dockerfile_file="${OUTPUT_DIR}/dockerfile-${TIMESTAMP}.json"
    if [ -f "$dockerfile_file" ] && [ -s "$dockerfile_file" ]; then
        local misconfig_count
        misconfig_count=$(jq '[.Results[]?.Misconfigurations[]?] | length' "$dockerfile_file" 2>/dev/null || echo "0")
