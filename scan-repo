                "$pip_file" 2>/dev/null >> "$md_file"
        else
            echo "No vulnerabilities found." >> "$md_file"
        fi
        echo "" >> "$md_file"
        echo "---" >> "$md_file"
        echo "" >> "$md_file"
    fi

    # --- OWASP Dependency-Check (Java) findings ---
    local dc_file="${OUTPUT_DIR}/dependency-check-${TIMESTAMP}.json"
    if [ -f "$dc_file" ] && [ -s "$dc_file" ]; then
        local dc_count
        dc_count=$(jq '[.dependencies[]?.vulnerabilities[]?] | length' "$dc_file" 2>/dev/null || echo "0")
