#!/bin/bash

###############################################################################
# scan-repo - Comprehensive Security Scanner
# 
# Usage: scan-repo [options] [directory]
#
# A powerful security scanning tool that runs multiple security scanners
# and generates comprehensive reports in multiple formats.
###############################################################################

VERSION="1.0.0"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
BOLD='\033[1m'
NC='\033[0m'

# Configuration
DEFAULT_OUTPUT_DIR="./security-reports"
DEFAULT_FORMAT="json"
VERBOSE=false
QUIET=false
CI_MODE=false
FAIL_ON_HIGH=false
FAIL_ON_CRITICAL=false
SKIP_SEMGREP=false
SKIP_TRIVY=false
SKIP_OSV=false
SKIP_GRYPE=false
SKIP_NPM=false
SKIP_JAVA=false
SKIP_LICENSE=false
GENERATE_HTML=false
GENERATE_MARKDOWN=false

# Counters for findings
CRITICAL_COUNT=0
HIGH_COUNT=0
MEDIUM_COUNT=0
LOW_COUNT=0

# Print functions
print_banner() {
    echo -e "${CYAN}"
    cat << EOF
╔════════════════════════════════════════════════════════════╗
║                                                            ║
║   ███████╗ ██████╗ █████╗ ███╗   ██╗    ██████╗ ███████╗ ║
║   ██╔════╝██╔════╝██╔══██╗████╗  ██║    ██╔══██╗██╔════╝ ║
║   ███████╗██║     ███████║██╔██╗ ██║    ██████╔╝█████╗   ║
║   ╚════██║██║     ██╔══██║██║╚██╗██║    ██╔══██╗██╔══╝   ║
║   ███████║╚██████╗██║  ██║██║ ╚████║    ██║  ██║███████╗ ║
║   ╚══════╝ ╚═════╝╚═╝  ╚═╝╚═╝  ╚═══╝    ╚═╝  ╚═╝╚══════╝ ║
║                                                            ║
║            Repository Security Scanner v${VERSION}            ║
╚════════════════════════════════════════════════════════════╝
EOF
    echo -e "${NC}"
}

print_info() { 
    [ "$QUIET" = false ] && echo -e "${BLUE}[INFO]${NC} $1"
}

print_success() { 
    [ "$QUIET" = false ] && echo -e "${GREEN}[✓]${NC} $1"
}

print_warning() { 
    echo -e "${YELLOW}[⚠]${NC} $1"
}

print_error() { 
    echo -e "${RED}[✗]${NC} $1"
}

print_verbose() {
    [ "$VERBOSE" = true ] && echo -e "${MAGENTA}[DEBUG]${NC} $1"
}

print_section() {
    [ "$QUIET" = false ] && echo -e "\n${CYAN}${BOLD}▶ $1${NC}"
}

# Usage information
show_usage() {
    cat << EOF
Usage: scan-repo [OPTIONS] [DIRECTORY]

Comprehensive security scanner for repositories. Runs multiple security
scanning tools and generates detailed reports.

Arguments:
  DIRECTORY              Directory to scan (default: current directory)

Options:
  -h, --help            Show this help message
  -v, --version         Show version information
  -o, --output DIR      Output directory for reports (default: ./security-reports)
  -f, --format FORMAT   Report format: json, html, markdown, all (default: json)
  
Scan Options:
  --skip-semgrep        Skip Semgrep SAST scan
  --skip-trivy          Skip Trivy scan
  --skip-osv            Skip OSV-Scanner
  --skip-grype          Skip Grype scan
  --skip-npm            Skip npm/yarn audit and related scans
  --skip-java           Skip OWASP Dependency-Check (Java)
  --skip-license        Skip license checking
  --only-sast           Run only SAST (Semgrep)
  --only-deps           Run only dependency scans
  --only-containers     Run only container scans

CI/CD Options:
  --ci                  CI mode: minimal output, exit codes
  --fail-on-critical    Exit with code 1 if critical findings
  --fail-on-high        Exit with code 1 if high severity findings
  --no-progress         Disable progress indicators

Output Options:
  --verbose             Verbose output
  --quiet               Minimal output (errors only)
  --json                Generate JSON report (default)
  --html                Generate HTML report
  --markdown            Generate Markdown report
  --all-formats         Generate all report formats

Examples:
  # Scan current directory
  scan-repo

  # Scan specific directory with HTML report
  scan-repo -f html /path/to/repo

  # CI mode with failure on critical issues
  scan-repo --ci --fail-on-critical

  # Run only SAST scan
  scan-repo --only-sast

  # Full scan with all report formats
  scan-repo --all-formats -o ./reports

  # Quiet mode for scripts
  scan-repo --quiet --json -o /tmp/scan

EOF
}

# Show version
show_version() {
    echo "scan-repo version $VERSION"
    echo ""
    echo "Available scanners:"
    command -v semgrep >/dev/null 2>&1 && echo "  ✓ Semgrep $(semgrep --version 2>&1 | head -n1)" || echo "  ✗ Semgrep (not installed)"
    command -v trivy >/dev/null 2>&1 && echo "  ✓ Trivy $(trivy --version 2>&1 | head -n1 | awk '{print $2}')" || echo "  ✗ Trivy (not installed)"
    command -v osv-scanner >/dev/null 2>&1 && echo "  ✓ OSV-Scanner" || echo "  ✗ OSV-Scanner (not installed)"
    command -v grype >/dev/null 2>&1 && echo "  ✓ Grype $(grype version 2>&1 | head -n1 | awk '{print $2}')" || echo "  ✗ Grype (not installed)"
    command -v npm >/dev/null 2>&1 && echo "  ✓ npm $(npm --version)" || echo "  ✗ npm (not installed)"
    command -v pip-audit >/dev/null 2>&1 && echo "  ✓ pip-audit $(pip-audit --version 2>&1 | head -n1)" || echo "  ✗ pip-audit (not installed)"
    command -v dependency-check >/dev/null 2>&1 && echo "  ✓ OWASP Dependency-Check $(dependency-check --version 2>&1 | head -n1)" || echo "  ✗ OWASP Dependency-Check (not installed)"
    command -v yarn >/dev/null 2>&1 && echo "  ✓ yarn $(yarn --version)" || echo "  ✗ yarn (not installed, optional)"
}

# Check if command exists
command_exists() {
    command -v "$1" >/dev/null 2>&1
}

# Validate prerequisites — auto-skips missing optional tools, only hard-fails if jq is absent
# or no scanners at all would run.
check_prerequisites() {
    # jq is mandatory: every scanner's JSON output is parsed with it
    if ! command_exists jq; then
        print_error "jq is required for JSON parsing but is not installed."
        print_error "Install it: apt-get install jq  /  brew install jq"
        return 1
    fi

    local any_scanner=false

    _check_tool() {
        local skip_var="$1" cmd="$2" label="$3"
        eval "local skip=\$$skip_var"
        if [ "$skip" = false ]; then
            if command_exists "$cmd"; then
                any_scanner=true
            else
                print_warning "$label not found — skipping (install with ./install.sh or pass --skip-${cmd})"
                eval "$skip_var=true"
            fi
        fi
    }

    _check_tool SKIP_SEMGREP semgrep    "Semgrep"
    _check_tool SKIP_TRIVY  trivy       "Trivy"
    _check_tool SKIP_OSV    osv-scanner "OSV-Scanner"
    _check_tool SKIP_GRYPE  grype       "Grype"

    # npm/yarn/pip-audit/dependency-check are optional — handled inside their own run_ functions
    any_scanner=true   # at least partial scan is always possible

    return 0
}

# Create output directory
setup_output_dir() {
    if [ ! -d "$OUTPUT_DIR" ]; then
        mkdir -p "$OUTPUT_DIR" || {
            print_error "Failed to create output directory: $OUTPUT_DIR"
            exit 1
        }
        print_verbose "Created output directory: $OUTPUT_DIR"
    fi
}

# Run Semgrep scan
run_semgrep() {
    if [ "$SKIP_SEMGREP" = true ]; then
        return 0
    fi
    
    print_section "Semgrep SAST Scan"
    
    if ! command_exists semgrep; then
        print_warning "Semgrep not installed, skipping"
        return 0
    fi
    
    local output_file="${OUTPUT_DIR}/semgrep-${TIMESTAMP}.json"
    
    print_info "Running Semgrep with multiple rulesets..."
    
    semgrep \
        --config=p/security-audit \
        --config=p/owasp-top-ten \
        --config=p/cwe-top-25 \
        --config=p/secrets \
        --json \
        --output="$output_file" \
        --no-git-ignore \
        --quiet \
        "$TARGET_DIR" 2>/dev/null || true
    
    if [ -f "$output_file" ]; then
        local findings=$(jq '.results | length' "$output_file" 2>/dev/null || echo "0")
        print_success "Semgrep scan complete: $findings findings"
        
        # Count severity
        local critical=$(jq '[.results[] | select(.extra.severity == "ERROR")] | length' "$output_file" 2>/dev/null || echo "0")
        local high=$(jq '[.results[] | select(.extra.severity == "WARNING")] | length' "$output_file" 2>/dev/null || echo "0")
        
        CRITICAL_COUNT=$((CRITICAL_COUNT + critical))
        HIGH_COUNT=$((HIGH_COUNT + high))
        
        print_verbose "  Critical: $critical, High: $high"
    else
        print_warning "Semgrep scan produced no output"
    fi
}

# Run Trivy scan
run_trivy() {
    if [ "$SKIP_TRIVY" = true ]; then
        return 0
    fi
    
    print_section "Trivy Vulnerability Scan"
    
    if ! command_exists trivy; then
        print_warning "Trivy not installed, skipping"
        return 0
    fi
    
    local output_file="${OUTPUT_DIR}/trivy-${TIMESTAMP}.json"
    
    print_info "Running Trivy filesystem scan..."
    
    trivy fs \
        --format json \
        --output "$output_file" \
        --scanners vuln,secret,config \
        --quiet \
        "$TARGET_DIR" 2>/dev/null || true
    
    if [ -f "$output_file" ]; then
        local findings=$(jq '[.Results[]?.Vulnerabilities[]?] | length' "$output_file" 2>/dev/null || echo "0")
        print_success "Trivy scan complete: $findings vulnerabilities"
        
        # Count severity
        local critical=$(jq '[.Results[]?.Vulnerabilities[]? | select(.Severity == "CRITICAL")] | length' "$output_file" 2>/dev/null || echo "0")
        local high=$(jq '[.Results[]?.Vulnerabilities[]? | select(.Severity == "HIGH")] | length' "$output_file" 2>/dev/null || echo "0")
        local medium=$(jq '[.Results[]?.Vulnerabilities[]? | select(.Severity == "MEDIUM")] | length' "$output_file" 2>/dev/null || echo "0")
        local low=$(jq '[.Results[]?.Vulnerabilities[]? | select(.Severity == "LOW")] | length' "$output_file" 2>/dev/null || echo "0")

        CRITICAL_COUNT=$((CRITICAL_COUNT + critical))
        HIGH_COUNT=$((HIGH_COUNT + high))
        MEDIUM_COUNT=$((MEDIUM_COUNT + medium))
        LOW_COUNT=$((LOW_COUNT + low))

        print_verbose "  Critical: $critical, High: $high, Medium: $medium, Low: $low"
    else
        print_warning "Trivy scan produced no output"
    fi

    # Scan Dockerfile if present
    if [ -f "$TARGET_DIR/Dockerfile" ]; then
        print_info "Scanning Dockerfile..."
        local dockerfile_output="${OUTPUT_DIR}/dockerfile-${TIMESTAMP}.json"

        trivy config \
            --format json \
            --output "$dockerfile_output" \
            --quiet \
            "$TARGET_DIR/Dockerfile" 2>/dev/null || true

        if [ -f "$dockerfile_output" ]; then
            local misconfig_count
            misconfig_count=$(jq '[.Results[]?.Misconfigurations[]?] | length' "$dockerfile_output" 2>/dev/null || echo "0")
            local misconfig_critical=$(jq '[.Results[]?.Misconfigurations[]? | select(.Severity == "CRITICAL")] | length' "$dockerfile_output" 2>/dev/null || echo "0")
            local misconfig_high=$(jq '[.Results[]?.Misconfigurations[]? | select(.Severity == "HIGH")] | length' "$dockerfile_output" 2>/dev/null || echo "0")
            local misconfig_medium=$(jq '[.Results[]?.Misconfigurations[]? | select(.Severity == "MEDIUM")] | length' "$dockerfile_output" 2>/dev/null || echo "0")
            local misconfig_low=$(jq '[.Results[]?.Misconfigurations[]? | select(.Severity == "LOW")] | length' "$dockerfile_output" 2>/dev/null || echo "0")

            CRITICAL_COUNT=$((CRITICAL_COUNT + misconfig_critical))
            HIGH_COUNT=$((HIGH_COUNT + misconfig_high))
            MEDIUM_COUNT=$((MEDIUM_COUNT + misconfig_medium))
            LOW_COUNT=$((LOW_COUNT + misconfig_low))

            print_success "Dockerfile scan complete: $misconfig_count misconfigurations"
        fi
    fi
}

# Run OSV-Scanner
run_osv_scanner() {
    if [ "$SKIP_OSV" = true ]; then
        return 0
    fi
    
    print_section "OSV Vulnerability Database Scan"
    
    if ! command_exists osv-scanner; then
        print_warning "OSV-Scanner not installed, skipping"
        return 0
    fi
    
    local output_file="${OUTPUT_DIR}/osv-${TIMESTAMP}.json"
    
    print_info "Running OSV-Scanner..."
    
    osv-scanner scan \
        --format json \
        --output "$output_file" \
        --recursive \
        "$TARGET_DIR" 2>/dev/null || true
    
    if [ -f "$output_file" ]; then
        local findings=$(jq '.results[].packages[].vulnerabilities | length' "$output_file" 2>/dev/null | awk '{s+=$1} END {print s+0}')
        print_success "OSV scan complete: $findings vulnerabilities"
    else
        print_warning "OSV scan produced no output"
    fi
}

# Run Grype scan
run_grype() {
    if [ "$SKIP_GRYPE" = true ]; then
        return 0
    fi
    
    print_section "Grype Vulnerability Scan"
    
    if ! command_exists grype; then
        print_warning "Grype not installed, skipping"
        return 0
    fi
    
    local output_file="${OUTPUT_DIR}/grype-${TIMESTAMP}.json"
    
    print_info "Running Grype scan..."
    
    grype dir:"$TARGET_DIR" -o json > "$output_file" 2>/dev/null || true
    
    if [ -f "$output_file" ]; then
        local findings=$(jq '.matches | length' "$output_file" 2>/dev/null || echo "0")
        print_success "Grype scan complete: $findings matches"
        
        # Count severity
        local critical=$(jq '[.matches[] | select(.vulnerability.severity == "Critical")] | length' "$output_file" 2>/dev/null || echo "0")
        local high=$(jq '[.matches[] | select(.vulnerability.severity == "High")] | length' "$output_file" 2>/dev/null || echo "0")
        local medium=$(jq '[.matches[] | select(.vulnerability.severity == "Medium")] | length' "$output_file" 2>/dev/null || echo "0")
        local low=$(jq '[.matches[] | select(.vulnerability.severity == "Low")] | length' "$output_file" 2>/dev/null || echo "0")

        CRITICAL_COUNT=$((CRITICAL_COUNT + critical))
        HIGH_COUNT=$((HIGH_COUNT + high))
        MEDIUM_COUNT=$((MEDIUM_COUNT + medium))
        LOW_COUNT=$((LOW_COUNT + low))

        print_verbose "  Critical: $critical, High: $high, Medium: $medium, Low: $low"
    else
        print_warning "Grype scan produced no output"
    fi
}

# Run npm audit
run_npm_audit() {
    if [ "$SKIP_NPM" = true ]; then
        return 0
    fi
    
    if [ ! -f "$TARGET_DIR/package.json" ]; then
        print_verbose "No package.json found, skipping npm scans"
        return 0
    fi
    
    print_section "npm Security Audit"
    
    if ! command_exists npm; then
        print_warning "npm not installed, skipping"
        return 0
    fi
    
    local output_file="${OUTPUT_DIR}/npm-audit-${TIMESTAMP}.json"
    
    print_info "Running npm audit..."
    
    (cd "$TARGET_DIR" && npm audit --json > "$output_file" 2>&1) || true
    
    if [ -f "$output_file" ]; then
        local critical=$(jq '.metadata.vulnerabilities.critical // 0' "$output_file" 2>/dev/null || echo "0")
        local high=$(jq '.metadata.vulnerabilities.high // 0' "$output_file" 2>/dev/null || echo "0")
        local medium=$(jq '.metadata.vulnerabilities.moderate // 0' "$output_file" 2>/dev/null || echo "0")
        local low=$(jq '.metadata.vulnerabilities.low // 0' "$output_file" 2>/dev/null || echo "0")
        local total=$(jq '.metadata.vulnerabilities.total // 0' "$output_file" 2>/dev/null || echo "0")

        print_success "npm audit complete: $total vulnerabilities"

        CRITICAL_COUNT=$((CRITICAL_COUNT + critical))
        HIGH_COUNT=$((HIGH_COUNT + high))
        MEDIUM_COUNT=$((MEDIUM_COUNT + medium))
        LOW_COUNT=$((LOW_COUNT + low))

        print_verbose "  Critical: $critical, High: $high, Medium: $medium, Low: $low"
    fi
    
    # Run retire.js if available
    if command_exists retire && [ "$SKIP_NPM" = false ]; then
        print_info "Running retire.js scan..."
        local retire_output="${OUTPUT_DIR}/retire-${TIMESTAMP}.json"
        
        (cd "$TARGET_DIR" && retire --outputformat json --outputpath "$retire_output" 2>/dev/null) || true
        
        if [ -f "$retire_output" ]; then
            print_success "retire.js scan complete"
        fi
    fi
}

# Run yarn audit (for yarn.lock projects)
run_yarn_audit() {
    if [ "$SKIP_NPM" = true ]; then
        return 0
    fi

    if [ ! -f "$TARGET_DIR/yarn.lock" ]; then
        print_verbose "No yarn.lock found, skipping yarn audit"
        return 0
    fi

    print_section "yarn Security Audit"

    if ! command_exists yarn; then
        print_warning "yarn not installed, skipping yarn audit"
        return 0
    fi

    local output_file="${OUTPUT_DIR}/yarn-audit-${TIMESTAMP}.json"

    print_info "Running yarn audit..."

    # yarn audit --json outputs NDJSON (one JSON object per line)
    (cd "$TARGET_DIR" && yarn audit --json 2>/dev/null) > "$output_file" || true

    if [ -f "$output_file" ] && [ -s "$output_file" ]; then
        # Extract the auditSummary line for counts
        local summary_line
        summary_line=$(grep '"type":"auditSummary"' "$output_file" 2>/dev/null | tail -n1)

        if [ -n "$summary_line" ]; then
            local critical high medium low total
            critical=$(echo "$summary_line" | jq '.data.vulnerabilities.critical // 0' 2>/dev/null || echo "0")
            high=$(echo "$summary_line"     | jq '.data.vulnerabilities.high // 0'     2>/dev/null || echo "0")
            medium=$(echo "$summary_line"   | jq '.data.vulnerabilities.moderate // 0' 2>/dev/null || echo "0")
            low=$(echo "$summary_line"      | jq '.data.vulnerabilities.low // 0'      2>/dev/null || echo "0")
            total=$(echo "$summary_line"    | jq '.data.vulnerabilities | to_entries | map(.value) | add // 0' 2>/dev/null || echo "0")

            print_success "yarn audit complete: $total vulnerabilities"

            CRITICAL_COUNT=$((CRITICAL_COUNT + critical))
            HIGH_COUNT=$((HIGH_COUNT + high))
            MEDIUM_COUNT=$((MEDIUM_COUNT + medium))
            LOW_COUNT=$((LOW_COUNT + low))
        else
            print_success "yarn audit complete: no vulnerabilities"
        fi
    else
        print_warning "yarn audit produced no output"
    fi
}

# Run pip-audit for Python dependency scanning
run_pip_audit() {
    if [ "$SKIP_NPM" = true ]; then
        # Reuse the --skip-npm flag to also skip pip-audit, keeping it simple
        return 0
    fi

    # Detect Python dependency files
    local has_python_deps=false
    for f in requirements.txt Pipfile.lock poetry.lock pyproject.toml setup.cfg; do
        [ -f "$TARGET_DIR/$f" ] && has_python_deps=true && break
    done

    if [ "$has_python_deps" = false ]; then
        print_verbose "No Python dependency files found, skipping pip-audit"
        return 0
    fi

    print_section "pip-audit Python Dependency Scan"

    if ! command_exists pip-audit; then
        print_warning "pip-audit not installed, skipping (install: pip install pip-audit)"
        return 0
    fi

    local output_file="${OUTPUT_DIR}/pip-audit-${TIMESTAMP}.json"

    print_info "Running pip-audit..."

    # pip-audit can scan a directory for requirement files
    pip-audit \
        --format json \
        --output "$output_file" \
        --path "$TARGET_DIR" \
        --no-deps \
        2>/dev/null || \
    pip-audit \
        --format json \
        --output "$output_file" \
        -r "$TARGET_DIR/requirements.txt" \
        2>/dev/null || true

    if [ -f "$output_file" ] && [ -s "$output_file" ]; then
        local findings
        findings=$(jq '[.dependencies[]?.vulns[]?] | length' "$output_file" 2>/dev/null || echo "0")
        print_success "pip-audit complete: $findings vulnerabilities"

        # pip-audit does not emit CVSS severities; count all findings as High for summary purposes
        HIGH_COUNT=$((HIGH_COUNT + findings))

        print_verbose "  Findings (counted as High): $findings"
    else
        print_warning "pip-audit produced no output"
    fi
}

# Run OWASP Dependency-Check (Java: pom.xml, Gradle, JARs, WARs, EARs)
run_dependency_check() {
    if [ "$SKIP_JAVA" = true ]; then
        return 0
    fi

    # Detect Java project files or compiled artifacts
    local has_java=false
    if find "$TARGET_DIR" -maxdepth 6 \
            \( -name "pom.xml" -o -name "build.gradle" -o -name "build.gradle.kts" \
               -o -name "*.jar" -o -name "*.war" -o -name "*.ear" \) \
            -print -quit 2>/dev/null | grep -q .; then
        has_java=true
    fi

    if [ "$has_java" = false ]; then
        print_verbose "No Java project files found, skipping OWASP Dependency-Check"
        return 0
    fi

    print_section "OWASP Dependency-Check (Java)"

    if ! command_exists dependency-check; then
        print_warning "OWASP Dependency-Check not installed, skipping (install: ./install.sh)"
        return 0
    fi

    # Ensure Java 11+ is available (DC 9+ requirement)
    local java_ver
    java_ver=$(java -version 2>&1 | grep -oP '(?<=version ")\d+' | head -n1 || true)
    [ "$java_ver" = "1" ] && java_ver=$(java -version 2>&1 | grep -oP '(?<=version "1\.)\d+' | head -n1 || true)
    if [ -z "$java_ver" ] || [ "$java_ver" -lt 11 ] 2>/dev/null; then
        print_warning "OWASP Dependency-Check requires Java 11+ (found: ${java_ver:-none}), skipping"
        return 0
    fi

    local dc_out_dir="${OUTPUT_DIR}/dc-${TIMESTAMP}"
    local output_file="${OUTPUT_DIR}/dependency-check-${TIMESTAMP}.json"

    print_info "Running OWASP Dependency-Check (first run downloads NVD DB ~300 MB)..."
    print_info "Tip: set NVD_API_KEY env var to speed up database updates"

    mkdir -p "$dc_out_dir"

    # Build optional NVD API key flag from environment — never hardcoded
    local nvd_key_flag=()
    if [ -n "${NVD_API_KEY:-}" ]; then
        nvd_key_flag=(--nvdApiKey "$NVD_API_KEY")
        print_verbose "Using NVD API key from NVD_API_KEY environment variable"
    fi

    dependency-check \
        --project "scan-$(basename "$TARGET_DIR")" \
        --scan "$TARGET_DIR" \
        --format JSON \
        --out "$dc_out_dir" \
        --disableAssembly \
        "${nvd_key_flag[@]}" \
        2>/dev/null || true

    local dc_report="${dc_out_dir}/dependency-check-report.json"
    if [ -f "$dc_report" ]; then
        mv "$dc_report" "$output_file"
        rm -rf "$dc_out_dir"

        local findings critical high medium low
        findings=$(jq '[.dependencies[]?.vulnerabilities[]?] | length' "$output_file" 2>/dev/null || echo "0")
        critical=$(jq '[.dependencies[]?.vulnerabilities[]? | select(.severity == "CRITICAL")] | length' "$output_file" 2>/dev/null || echo "0")
        high=$(jq '[.dependencies[]?.vulnerabilities[]? | select(.severity == "HIGH")] | length' "$output_file" 2>/dev/null || echo "0")
        medium=$(jq '[.dependencies[]?.vulnerabilities[]? | select(.severity == "MEDIUM")] | length' "$output_file" 2>/dev/null || echo "0")
        low=$(jq '[.dependencies[]?.vulnerabilities[]? | select(.severity == "LOW")] | length' "$output_file" 2>/dev/null || echo "0")

        print_success "OWASP Dependency-Check complete: $findings vulnerabilities"

        CRITICAL_COUNT=$((CRITICAL_COUNT + critical))
        HIGH_COUNT=$((HIGH_COUNT + high))
        MEDIUM_COUNT=$((MEDIUM_COUNT + medium))
        LOW_COUNT=$((LOW_COUNT + low))

        print_verbose "  Critical: $critical, High: $high, Medium: $medium, Low: $low"
    else
        print_warning "OWASP Dependency-Check produced no report"
        rm -rf "$dc_out_dir"
    fi
}

# Run license checker
run_license_check() {
    if [ "$SKIP_LICENSE" = true ]; then
        return 0
    fi
    
    if [ ! -f "$TARGET_DIR/package.json" ]; then
        return 0
    fi
    
    print_section "License Compliance Check"
    
    if ! command_exists license-checker; then
        print_warning "license-checker not installed, skipping"
        return 0
    fi
    
    local output_file="${OUTPUT_DIR}/licenses-${TIMESTAMP}.json"
    
    print_info "Checking licenses..."
    
    (cd "$TARGET_DIR" && license-checker --json --out "$output_file" 2>/dev/null) || true
    
    if [ -f "$output_file" ]; then
        local count=$(jq 'keys | length' "$output_file" 2>/dev/null || echo "0")
        print_success "License check complete: $count packages"
    fi
}

