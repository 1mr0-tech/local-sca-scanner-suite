            local basename=$(basename "$report")
            echo "                <li><code>$basename</code></li>" >> "$html_file"
        fi
    done
    
    cat >> "$html_file" << EOF
            </ul>
        </div>
        
        <div style="margin-top: 40px; padding-top: 20px; border-top: 1px solid #ddd; color: #666; font-size: 12px;">
            Generated by scan-repo v$VERSION
        </div>
    </div>
</body>
</html>
EOF
    
    print_success "HTML report generated: $html_file"
}

# Generate Markdown report
generate_markdown_report() {
    if [ "$GENERATE_MARKDOWN" = false ]; then
        return 0
    fi

    print_info "Generating Markdown report..."

    local md_file="${OUTPUT_DIR}/REPORT-${TIMESTAMP}.md"

    cat > "$md_file" << EOF
# Security Scan Report

**Generated:** $(date)
**Target:** \`$TARGET_DIR\`
**Scanner Version:** $VERSION

---

## Summary

| Severity | Count |
|----------|-------|
| Critical | $CRITICAL_COUNT |
| High | $HIGH_COUNT |
| Medium | $MEDIUM_COUNT |
| Low | $LOW_COUNT |

**Total Issues:** $((CRITICAL_COUNT + HIGH_COUNT + MEDIUM_COUNT + LOW_COUNT))

---

EOF

    # --- Semgrep findings ---
    local semgrep_file="${OUTPUT_DIR}/semgrep-${TIMESTAMP}.json"
    if [ -f "$semgrep_file" ] && [ -s "$semgrep_file" ]; then
        local semgrep_count
        semgrep_count=$(jq '.results | length' "$semgrep_file" 2>/dev/null || echo "0")
        echo "## Semgrep SAST ($semgrep_count findings)" >> "$md_file"
        echo "" >> "$md_file"
        if [ "$semgrep_count" -gt 0 ]; then
            echo "| Severity | Rule | File | Line | Message |" >> "$md_file"
            echo "|----------|------|------|------|---------|" >> "$md_file"
            jq -r '.results[] | "| \(.extra.severity // "INFO") | `\(.check_id)` | `\(.path)` | \(.start.line) | \(.extra.message | gsub("\n"; " ") | .[0:120]) |"' \
                "$semgrep_file" 2>/dev/null >> "$md_file"
        else
            echo "No findings." >> "$md_file"
        fi
        echo "" >> "$md_file"
        echo "---" >> "$md_file"
        echo "" >> "$md_file"
    fi

    # --- Trivy findings ---
    local trivy_file="${OUTPUT_DIR}/trivy-${TIMESTAMP}.json"
    if [ -f "$trivy_file" ] && [ -s "$trivy_file" ]; then
        local trivy_count
        trivy_count=$(jq '[.Results[]?.Vulnerabilities[]?] | length' "$trivy_file" 2>/dev/null || echo "0")
        echo "## Trivy Vulnerability Scan ($trivy_count findings)" >> "$md_file"
        echo "" >> "$md_file"
        if [ "$trivy_count" -gt 0 ]; then
            echo "| Severity | CVE | Package | Installed | Fixed In | Title |" >> "$md_file"
            echo "|----------|-----|---------|-----------|----------|-------|" >> "$md_file"
            jq -r '.Results[]? | .Vulnerabilities[]? | "| \(.Severity) | \(.VulnerabilityID) | `\(.PkgName)` | \(.InstalledVersion) | \(.FixedVersion // "N/A") | \(.Title // .Description[0:80] // "N/A") |"' \
                "$trivy_file" 2>/dev/null >> "$md_file"
        else
            echo "No findings." >> "$md_file"
        fi
        echo "" >> "$md_file"
        echo "---" >> "$md_file"
        echo "" >> "$md_file"
    fi

    # --- Grype findings ---
    local grype_file="${OUTPUT_DIR}/grype-${TIMESTAMP}.json"
    if [ -f "$grype_file" ] && [ -s "$grype_file" ]; then
        local grype_count
        grype_count=$(jq '.matches | length' "$grype_file" 2>/dev/null || echo "0")
        echo "## Grype Vulnerability Scan ($grype_count findings)" >> "$md_file"
        echo "" >> "$md_file"
        if [ "$grype_count" -gt 0 ]; then
            echo "| Severity | CVE | Package | Version | Fix Available |" >> "$md_file"
            echo "|----------|-----|---------|---------|---------------|" >> "$md_file"
            jq -r '.matches[] | "| \(.vulnerability.severity) | \(.vulnerability.id) | `\(.artifact.name)` | \(.artifact.version) | \(.vulnerability.fix.versions[0] // "N/A") |"' \
                "$grype_file" 2>/dev/null >> "$md_file"
        else
            echo "No findings." >> "$md_file"
        fi
        echo "" >> "$md_file"
        echo "---" >> "$md_file"
        echo "" >> "$md_file"
    fi

    # --- OSV findings ---
    local osv_file="${OUTPUT_DIR}/osv-${TIMESTAMP}.json"
    if [ -f "$osv_file" ] && [ -s "$osv_file" ]; then
        local osv_count
        osv_count=$(jq '.results[].packages[].vulnerabilities | length' "$osv_file" 2>/dev/null | awk '{s+=$1} END {print s+0}')
        echo "## OSV Vulnerability Database ($osv_count findings)" >> "$md_file"
        echo "" >> "$md_file"
        if [ "$osv_count" -gt 0 ]; then
            echo "| Vulnerability ID | Package | Version | Summary |" >> "$md_file"
            echo "|-----------------|---------|---------|---------|" >> "$md_file"
            jq -r '.results[].packages[] | .package as $pkg | .vulnerabilities[]? | "| \(.id) | `\($pkg.name)` | \($pkg.version) | \(.summary // .details[0:100] // "N/A") |"' \
                "$osv_file" 2>/dev/null >> "$md_file"
        else
            echo "No findings." >> "$md_file"
        fi
        echo "" >> "$md_file"
        echo "---" >> "$md_file"
        echo "" >> "$md_file"
    fi

    # --- Dockerfile / IaC findings ---
    local dockerfile_file="${OUTPUT_DIR}/dockerfile-${TIMESTAMP}.json"
    if [ -f "$dockerfile_file" ] && [ -s "$dockerfile_file" ]; then
        local misconfig_count
        misconfig_count=$(jq '[.Results[]?.Misconfigurations[]?] | length' "$dockerfile_file" 2>/dev/null || echo "0")
        echo "## Dockerfile / IaC Misconfigurations ($misconfig_count findings)" >> "$md_file"
        echo "" >> "$md_file"
        if [ "$misconfig_count" -gt 0 ]; then
            echo "| Severity | ID | Title | Line | Message |" >> "$md_file"
            echo "|----------|----|-------|------|---------|" >> "$md_file"
            jq -r '.Results[]?.Misconfigurations[]? | "| \(.Severity) | \(.ID) | \(.Title) | \(.CauseMetadata.StartLine // "N/A") | \(.Message) |"' \
                "$dockerfile_file" 2>/dev/null >> "$md_file"
        else
            echo "No misconfigurations found." >> "$md_file"
        fi
        echo "" >> "$md_file"
        echo "---" >> "$md_file"
        echo "" >> "$md_file"
    fi

    # --- npm audit findings ---
    local npm_file="${OUTPUT_DIR}/npm-audit-${TIMESTAMP}.json"
    if [ -f "$npm_file" ] && [ -s "$npm_file" ]; then
        local npm_pkg_count npm_advisory_count
        npm_pkg_count=$(jq '.metadata.vulnerabilities.total // 0' "$npm_file" 2>/dev/null || echo "0")
        npm_advisory_count=$(jq '[.vulnerabilities | to_entries[] | .value.via[] | select(type == "object")] | length' "$npm_file" 2>/dev/null || echo "0")
        echo "## npm Audit ($npm_advisory_count advisories in $npm_pkg_count vulnerable packages)" >> "$md_file"
        echo "" >> "$md_file"
        if [ "$npm_pkg_count" -gt 0 ]; then
            echo "| Severity | Package | Advisory | URL |" >> "$md_file"
            echo "|----------|---------|----------|-----|" >> "$md_file"
            jq -r '.vulnerabilities | to_entries[] | .value as $v | .value.via[] | select(type == "object") | "| \($v.severity | ascii_upcase | gsub("MODERATE"; "MEDIUM")) | `\($v.name)` | \(.title) | \(.url) |"' \
                "$npm_file" 2>/dev/null >> "$md_file"
        else
            echo "No vulnerabilities found." >> "$md_file"
        fi
        echo "" >> "$md_file"
        echo "---" >> "$md_file"
        echo "" >> "$md_file"
    fi

    cat >> "$md_file" << EOF
## Next Steps

### Critical & High Priority
1. Review and fix critical vulnerabilities immediately
2. Update dependencies with known high-severity CVEs
3. Remove any hardcoded secrets or credentials

### Medium Priority
- Review medium severity findings
- Update dependencies where feasible
- Implement security best practices

### Low Priority
- Address code quality issues
- Review informational findings
- Consider security enhancements

---

*Report generated by scan-repo v$VERSION*
EOF

    print_success "Markdown report generated: $md_file"
}

# Parse command line arguments
parse_args() {
    while [[ $# -gt 0 ]]; do
        case $1 in
            -h|--help)
                show_usage
                exit 0
                ;;
            -v|--version)
                show_version
                exit 0
                ;;
            -o|--output)
                OUTPUT_DIR="$2"
                shift 2
                ;;
            -f|--format)
                case $2 in
                    json) DEFAULT_FORMAT="json" ;;
                    html) GENERATE_HTML=true ;;
                    markdown) GENERATE_MARKDOWN=true ;;
                    all) GENERATE_HTML=true; GENERATE_MARKDOWN=true ;;
                    *) print_error "Unknown format: $2"; exit 1 ;;
                esac
                shift 2
                ;;
            --skip-semgrep) SKIP_SEMGREP=true; shift ;;
            --skip-trivy) SKIP_TRIVY=true; shift ;;
            --skip-osv) SKIP_OSV=true; shift ;;
            --skip-grype) SKIP_GRYPE=true; shift ;;
            --skip-npm) SKIP_NPM=true; shift ;;
            --skip-license) SKIP_LICENSE=true; shift ;;
            --only-sast)
                SKIP_TRIVY=true; SKIP_OSV=true; SKIP_GRYPE=true
                SKIP_NPM=true; SKIP_LICENSE=true
                shift
                ;;
            --only-deps)
                SKIP_SEMGREP=true
                shift
                ;;
            --only-containers)
                SKIP_SEMGREP=true; SKIP_OSV=true; SKIP_GRYPE=true
                SKIP_NPM=true; SKIP_LICENSE=true
                shift
                ;;
            --ci) CI_MODE=true; QUIET=true; shift ;;
            --fail-on-critical) FAIL_ON_CRITICAL=true; shift ;;
            --fail-on-high) FAIL_ON_HIGH=true; shift ;;
            --verbose) VERBOSE=true; shift ;;
            --quiet) QUIET=true; shift ;;
            --json) DEFAULT_FORMAT="json"; shift ;;
            --html) GENERATE_HTML=true; shift ;;
            --markdown) GENERATE_MARKDOWN=true; shift ;;
            --all-formats) GENERATE_HTML=true; GENERATE_MARKDOWN=true; shift ;;
            --no-progress) shift ;;
            -*)
                print_error "Unknown option: $1"
                echo "Use --help for usage information"
                exit 1
                ;;
            *)
                TARGET_DIR="$1"
                shift
                ;;
        esac
    done
}

# Main execution
main() {
    # Set defaults
    TARGET_DIR="${TARGET_DIR:-.}"
    OUTPUT_DIR="${OUTPUT_DIR:-$DEFAULT_OUTPUT_DIR}"
    TIMESTAMP=$(date +%Y%m%d_%H%M%S)
    
    # Resolve to absolute path
    TARGET_DIR=$(cd "$TARGET_DIR" 2>/dev/null && pwd || echo "$TARGET_DIR")
    
    # Show banner unless quiet
    [ "$QUIET" = false ] && [ "$CI_MODE" = false ] && print_banner
    
    # Validate target directory
    if [ ! -d "$TARGET_DIR" ]; then
        print_error "Directory not found: $TARGET_DIR"
        exit 1
    fi
    
    print_info "Target directory: $TARGET_DIR"
    print_info "Output directory: $OUTPUT_DIR"
    print_info "Timestamp: $TIMESTAMP"
    
    # Check prerequisites
    check_prerequisites || exit 1
    
    # Setup output directory
    setup_output_dir
    
    # Run scans
    print_section "Starting Security Scans"
    
    run_semgrep
    run_trivy
    run_osv_scanner
    run_grype
    run_npm_audit
    run_license_check
    
    # Generate reports
    generate_html_report
    generate_markdown_report
    
    # Show summary
    [ "$QUIET" = false ] && generate_summary
    
    # Determine exit code
    local exit_code=0
    
    if [ "$FAIL_ON_CRITICAL" = true ] && [ "$CRITICAL_COUNT" -gt 0 ]; then
        print_error "Critical vulnerabilities found: $CRITICAL_COUNT"
        exit_code=1
    elif [ "$FAIL_ON_HIGH" = true ] && [ "$HIGH_COUNT" -gt 0 ]; then
        print_error "High severity vulnerabilities found: $HIGH_COUNT"
        exit_code=1
    fi
    
    if [ $exit_code -eq 0 ]; then
        [ "$QUIET" = false ] && print_success "Scan completed successfully!"
    fi
    
    exit $exit_code
}

# Parse arguments and run
parse_args "$@"
main
