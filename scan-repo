                "$npm_file" 2>/dev/null >> "$md_file"
        else
            echo "No vulnerabilities found." >> "$md_file"
        fi
        echo "" >> "$md_file"
        echo "---" >> "$md_file"
        echo "" >> "$md_file"
    fi

    # --- yarn audit findings ---
    local yarn_file="${OUTPUT_DIR}/yarn-audit-${TIMESTAMP}.json"
    if [ -f "$yarn_file" ] && [ -s "$yarn_file" ]; then
        local yarn_advisory_count
        yarn_advisory_count=$(grep '"type":"auditAdvisory"' "$yarn_file" 2>/dev/null | wc -l | tr -d ' ')
        echo "## yarn Audit ($yarn_advisory_count advisories)" >> "$md_file"
        echo "" >> "$md_file"
        if [ "$yarn_advisory_count" -gt 0 ]; then
            echo "| Severity | Package | Advisory | URL |" >> "$md_file"
            echo "|----------|---------|----------|-----|" >> "$md_file"
            grep '"type":"auditAdvisory"' "$yarn_file" 2>/dev/null | \
                jq -r '.data.advisory | "| \(.severity | ascii_upcase | gsub("MODERATE"; "MEDIUM")) | `\(.module_name)` | \(.title) | \(.url) |"' \
                2>/dev/null >> "$md_file"
        else
            echo "No vulnerabilities found." >> "$md_file"
        fi
        echo "" >> "$md_file"
        echo "---" >> "$md_file"
        echo "" >> "$md_file"
    fi

    # --- pip-audit findings ---
    local pip_file="${OUTPUT_DIR}/pip-audit-${TIMESTAMP}.json"
    if [ -f "$pip_file" ] && [ -s "$pip_file" ]; then
        local pip_count
        pip_count=$(jq '[.dependencies[]?.vulns[]?] | length' "$pip_file" 2>/dev/null || echo "0")
        echo "## pip-audit Python Dependency Scan ($pip_count findings)" >> "$md_file"
        echo "" >> "$md_file"
        if [ "$pip_count" -gt 0 ]; then
